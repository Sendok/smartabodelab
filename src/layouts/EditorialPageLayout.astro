---
import SiteLayout from "./SiteLayout.astro";
import { breadcrumbSchema, editorialPageSchema } from "../utils/seo";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  eyebrow?: string;
  updated?: string;
}

const { title, description, canonicalPath, eyebrow = "Editorial standards", updated } = Astro.props;
const pageSchema = editorialPageSchema(title, description, canonicalPath);
const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "/" },
  { name: title, url: canonicalPath }
]);
---

<SiteLayout title={`${title} | SmartAbodeLab`} description={description} canonicalPath={canonicalPath} jsonLd={[pageSchema, breadcrumbs]}>
  <article>
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-slate-500">
          <a href="/" class="hover:text-brand-dark">Home</a><span aria-hidden="true">›</span><span aria-current="page" class="text-slate-700">{title}</span>
        </nav>
        <p class="mt-7 text-xs font-black uppercase tracking-[0.18em] text-brand-dark">{eyebrow}</p>
        <h1 class="mt-2 text-4xl font-black leading-tight tracking-[-0.045em] text-ink sm:text-5xl">{title}</h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">{description}</p>
        {updated && <p class="mt-4 text-xs font-semibold text-slate-500">Last updated: {updated}</p>}
      </div>
    </header>
    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="article-prose"><slot /></div>
    </div>
  </article>
</SiteLayout>
