---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import { breadcrumbSchema, editorialPageSchema } from "../utils/seo";

const authors = await getCollection("authors");
const title = "Masthead";
const description = "Meet the writers and editors behind SmartAbodeLab and the areas they cover.";
const canonicalPath = "/masthead";
const pageSchema = editorialPageSchema(title, description, canonicalPath);
const breadcrumbs = breadcrumbSchema([{ name: "Home", url: "/" }, { name: title, url: canonicalPath }]);
---

<SiteLayout title="Masthead | SmartAbodeLab" description={description} canonicalPath={canonicalPath} jsonLd={[pageSchema, breadcrumbs]}>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-slate-500">
      <a href="/" class="hover:text-brand-dark">Home</a><span aria-hidden="true">›</span><span aria-current="page" class="text-slate-700">Masthead</span>
    </nav>
    <div class="mt-7 max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-dark">Editorial team</p>
      <h1 class="mt-2 text-4xl font-black tracking-[-0.045em] text-ink sm:text-5xl">Masthead</h1>
      <p class="mt-4 text-lg leading-8 text-slate-600">{description}</p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {authors.map((author) => (
        <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex gap-5">
            <img src={author.data.avatar} alt={author.data.name} width="96" height="96" class="size-20 shrink-0 rounded-2xl object-cover sm:size-24" />
            <div>
              <h2 class="text-xl font-black tracking-tight text-ink"><a href={`/author/${author.id}`} class="hover:text-brand-dark">{author.data.name}</a></h2>
              <p class="mt-1 text-sm font-bold text-brand-dark">{author.data.role}</p>
              <p class="mt-3 text-sm leading-6 text-slate-600">{author.data.bio}</p>
            </div>
          </div>
          {author.data.expertise.length > 0 && <div class="mt-5 flex flex-wrap gap-2">{author.data.expertise.slice(0, 5).map((item) => <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-extrabold text-brand-dark">{item}</span>)}</div>}
        </article>
      ))}
    </div>

    {import.meta.env.DEV && (
      <div class="mt-10 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm leading-6 text-amber-950">
        <strong>Development note:</strong> The included author profiles are demonstration content. Replace them with real contributors, real bios, and only verifiable credentials before production launch.
      </div>
    )}
  </section>
</SiteLayout>
