---
import { getCollection, getEntry, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import TopicCard from "../../components/content-engine/TopicCard.astro";
import { SITE } from "../../config/site";
import { absoluteUrl, breadcrumbSchema, type JsonLdNode } from "../../utils/seo";
import { getPublishedArticles } from "../../utils/content";

export async function getStaticPaths() {
  const clusters = await getCollection("clusters");
  return clusters.map((cluster) => ({ params: { cluster: cluster.id }, props: { cluster } }));
}

const { cluster } = Astro.props;
const allArticles = await getPublishedArticles();
const articles = allArticles.filter((article) => article.data.cluster.id === cluster.id);
const pillar = cluster.data.pillarArticle ? await getEntry("articles", cluster.data.pillarArticle) : articles[0];
const supporting = articles.filter((article) => article.id !== pillar?.id);
const relatedClusters = cluster.data.relatedClusters.length
  ? (await Promise.all(cluster.data.relatedClusters.map((id) => getEntry("clusters", id)))).filter(Boolean)
  : [];
const { Content } = await render(cluster);

const byStage = {
  awareness: supporting.filter((article) => article.data.funnelStage === "awareness"),
  consideration: supporting.filter((article) => article.data.funnelStage === "consideration"),
  decision: supporting.filter((article) => article.data.funnelStage === "decision")
};

const canonicalPath = `/topics/${cluster.id}`;
const canonicalUrl = absoluteUrl(canonicalPath);
const collectionSchema: JsonLdNode = {
  "@type": "CollectionPage",
  "@id": canonicalUrl,
  url: canonicalUrl,
  name: `${cluster.data.title} | ${SITE.name}`,
  description: cluster.data.description,
  inLanguage: SITE.language,
  isPartOf: { "@id": SITE.websiteId },
  about: [cluster.data.primaryKeyword, ...cluster.data.aliases].map((name) => ({ "@type": "Thing", name })),
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: articles.length,
    itemListElement: articles.map((article, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: absoluteUrl(`/articles/${article.id}`),
      name: article.data.title
    }))
  }
};
const breadcrumbs = breadcrumbSchema([{ name: "Home", url: "/" }, { name: cluster.data.title, url: canonicalPath }]);
---

<SiteLayout title={`${cluster.data.title} | SmartAbodeLab`} description={cluster.data.description} canonicalPath={canonicalPath} jsonLd={[collectionSchema, breadcrumbs]}>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
      <nav aria-label="Breadcrumb" class="mb-7 flex items-center gap-2 text-xs font-semibold text-slate-500"><a href="/" class="hover:text-brand-dark">Home</a><span aria-hidden="true">›</span><span aria-current="page" class="text-slate-700">{cluster.data.title}</span></nav>
      <div class="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-end">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-dark">SmartAbodeLab topic hub</p>
          <h1 class="mt-2 max-w-4xl text-4xl font-black leading-[1.05] tracking-[-0.05em] text-ink sm:text-5xl lg:text-6xl">{cluster.data.title}</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">{cluster.data.description}</p>
        </div>
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5">
          <p class="text-xs font-black uppercase tracking-[0.14em] text-brand-dark">Coverage map</p>
          <p class="mt-2 text-3xl font-black tracking-tight text-ink">{articles.length}</p>
          <p class="text-sm font-semibold text-slate-600">published {articles.length === 1 ? "article" : "articles"}</p>
          <p class="mt-3 text-xs leading-5 text-slate-500">Primary topic: {cluster.data.primaryKeyword}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="grid gap-10 lg:grid-cols-[1fr_340px]">
      <div>
        <div class="article-prose max-w-3xl"><Content /></div>

        {pillar && (
          <section class="mt-10" aria-labelledby="pillar-title">
            <p class="text-xs font-black uppercase tracking-[0.16em] text-brand-dark">Start here</p>
            <h2 id="pillar-title" class="mt-2 text-3xl font-black tracking-[-0.04em] text-ink">Pillar guide</h2>
            <div class="mt-5"><ArticleCard article={pillar} /></div>
          </section>
        )}
      </div>

      <aside class="space-y-5">
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-black uppercase tracking-[0.14em] text-brand-dark">Questions we answer</p>
          <div class="mt-4 grid gap-3">{cluster.data.keyQuestions.map((question) => <p class="text-sm font-bold leading-5 text-slate-700">{question}</p>)}</div>
        </section>
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-black uppercase tracking-[0.14em] text-brand-dark">Subtopics</p>
          <div class="mt-4 grid gap-4">{cluster.data.subtopics.map((subtopic) => <div><h2 class="text-sm font-extrabold text-ink">{subtopic.name}</h2><p class="mt-1 text-xs leading-5 text-slate-500">{subtopic.description}</p></div>)}</div>
        </section>
      </aside>
    </div>

    {byStage.awareness.length > 0 && <section class="mt-14"><p class="text-xs font-black uppercase tracking-[0.16em] text-brand-dark">Learn the fundamentals</p><h2 class="mt-2 text-3xl font-black tracking-[-0.04em] text-ink">Understand the topic</h2><div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{byStage.awareness.map((article) => <ArticleCard article={article} />)}</div></section>}
    {byStage.consideration.length > 0 && <section class="mt-14"><p class="text-xs font-black uppercase tracking-[0.16em] text-brand-dark">Go deeper</p><h2 class="mt-2 text-3xl font-black tracking-[-0.04em] text-ink">Compare options and trade-offs</h2><div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{byStage.consideration.map((article) => <ArticleCard article={article} />)}</div></section>}
    {byStage.decision.length > 0 && <section class="mt-14"><p class="text-xs font-black uppercase tracking-[0.16em] text-brand-dark">Make a decision</p><h2 class="mt-2 text-3xl font-black tracking-[-0.04em] text-ink">Reviews and recommendations</h2><div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{byStage.decision.map((article) => <ArticleCard article={article} />)}</div></section>}

    {relatedClusters.length > 0 && <section class="mt-16 border-t border-slate-200 pt-12"><p class="text-xs font-black uppercase tracking-[0.16em] text-brand-dark">Connected topics</p><h2 class="mt-2 text-3xl font-black tracking-[-0.04em] text-ink">Continue exploring</h2><div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{relatedClusters.map((item) => item && <TopicCard cluster={item} articleCount={allArticles.filter((a) => a.data.cluster.id === item.id).length} />)}</div></section>}
  </section>
</SiteLayout>
