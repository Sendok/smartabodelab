---
import SiteLayout from "../../layouts/SiteLayout.astro";
import TopicCard from "../../components/content-engine/TopicCard.astro";
import { getOrderedClusters } from "../../utils/clusters";
import { getPublishedArticles } from "../../utils/content";
import { absoluteUrl, breadcrumbSchema, type JsonLdNode } from "../../utils/seo";
import { SITE } from "../../config/site";

const clusters = await getOrderedClusters();
const articles = await getPublishedArticles();
const canonicalPath = "/topics";
const canonicalUrl = absoluteUrl(canonicalPath);
const collectionSchema: JsonLdNode = {
  "@type": "CollectionPage",
  "@id": canonicalUrl,
  url: canonicalUrl,
  name: `Topics | ${SITE.name}`,
  description: "Explore SmartAbodeLab topic hubs for smart energy, home automation, urban living, and evidence-aware product reviews.",
  inLanguage: SITE.language,
  isPartOf: { "@id": SITE.websiteId },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: clusters.length,
    itemListElement: clusters.map((cluster, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: absoluteUrl(`/topics/${cluster.id}`),
      name: cluster.data.title
    }))
  }
};
const breadcrumbs = breadcrumbSchema([{ name: "Home", url: "/" }, { name: "Topics", url: canonicalPath }]);
---

<SiteLayout title="Topics | SmartAbodeLab" description="Explore SmartAbodeLab topic hubs for smart energy, home automation, urban living, and evidence-aware product reviews." canonicalPath={canonicalPath} jsonLd={[collectionSchema, breadcrumbs]}>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <nav aria-label="Breadcrumb" class="mb-7 flex items-center gap-2 text-xs font-semibold text-slate-500"><a href="/" class="hover:text-brand-dark">Home</a><span aria-hidden="true">›</span><span aria-current="page" class="text-slate-700">Topics</span></nav>
    <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-dark">Knowledge map</p>
    <h1 class="mt-2 max-w-4xl text-4xl font-black tracking-[-0.045em] text-ink sm:text-5xl">Explore SmartAbodeLab by topic.</h1>
    <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600">Start with a pillar hub, then move through explainers, comparisons, practical guides, and reviews as your question becomes more specific.</p>
    <div class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{clusters.map((cluster) => <TopicCard cluster={cluster} articleCount={articles.filter((article) => article.data.cluster.id === cluster.id).length} />)}</div>
  </section>
</SiteLayout>
