---
import SiteLayout from "../layouts/SiteLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Newsletter from "../components/Newsletter.astro";
import TopicCard from "../components/content-engine/TopicCard.astro";
import { getPublishedArticles, formatDate } from "../utils/content";
import { getOrderedClusters } from "../utils/clusters";

const articles = await getPublishedArticles();
const clusters = await getOrderedClusters();
const mainStory = articles.find((article) => article.data.editorsPick) ?? articles[0];
const secondaryStories = articles.filter((article) => article.id !== mainStory?.id && article.data.featured).slice(0, 2);
const tabs = [["all","All"],["energy","Energy Efficiency"],["iot","IoT Protocols"],["appliances","Smart Appliances"],["apartment","Apartment Hacks"]];
---
<SiteLayout>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16">
      <div class="mb-7 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div><p class="text-xs font-black uppercase tracking-[0.18em] text-brand-dark">Independent eco-tech editorial</p><h1 class="mt-2 max-w-3xl text-3xl font-black leading-[1.04] tracking-[-0.045em] text-ink sm:text-4xl lg:text-5xl">A smarter home starts with better decisions—not more devices.</h1></div>
        <p class="max-w-md text-sm leading-6 text-slate-600 sm:text-base">Practical guides and tested ideas for automation, energy efficiency, and modern city living.</p>
      </div>
      {mainStory && <div class="grid gap-5 lg:grid-cols-[1.6fr_0.9fr]">
        <article class="group relative min-h-[430px] overflow-hidden rounded-3xl bg-slate-900 shadow-xl sm:min-h-[520px]">
          <img src={mainStory.data.image} alt={mainStory.data.imageAlt} width="1280" height="720" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]" /><div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/55 to-slate-950/5"></div>
          <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8 lg:p-10"><div class="flex flex-wrap items-center gap-2 text-xs font-extrabold"><span class="rounded-full bg-amber-50 px-3 py-1.5 text-amber-950 ring-1 ring-inset ring-amber-200">EDITOR'S PICK</span><span class="rounded-full bg-white/15 px-3 py-1.5 text-white backdrop-blur">{mainStory.data.category}</span></div><h2 class="mt-4 max-w-3xl text-3xl font-black leading-[1.08] tracking-[-0.04em] text-white sm:text-4xl"><a href={`/articles/${mainStory.id}`} class="after:absolute after:inset-0">{mainStory.data.title}</a></h2><p class="mt-4 max-w-2xl text-sm leading-6 text-slate-200 sm:text-base">{mainStory.data.description}</p><p class="mt-4 text-sm font-bold text-emerald-100">{mainStory.data.readTime} <span class="mx-2">·</span> {formatDate(mainStory.data.publishedAt)}</p></div>
        </article>
        <div class="grid gap-5">{secondaryStories.map((story) => <article class="group grid min-h-[205px] overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 shadow-sm sm:grid-cols-[0.95fr_1.05fr] lg:grid-cols-1 xl:grid-cols-[0.95fr_1.05fr]"><a href={`/articles/${story.id}`} class="overflow-hidden"><img src={story.data.image} alt={story.data.imageAlt} width="640" height="430" loading="lazy" decoding="async" class="h-full min-h-44 w-full object-cover transition duration-500 group-hover:scale-[1.035]" /></a><div class="flex flex-col justify-center p-5"><span class="text-xs font-extrabold text-brand-dark">{story.data.category}</span><h2 class="mt-2 text-xl font-black leading-tight tracking-[-0.025em] text-ink"><a href={`/articles/${story.id}`} class="hover:text-brand-dark">{story.data.title}</a></h2><p class="mt-3 text-xs font-semibold text-slate-500">{formatDate(story.data.publishedAt)} · {story.data.readTime}</p></div></article>)}</div>
      </div>}
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6 lg:px-8 lg:pt-16" aria-labelledby="topics-title">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div><p class="text-xs font-black uppercase tracking-[0.18em] text-brand-dark">Explore by topic</p><h2 id="topics-title" class="mt-2 text-3xl font-black tracking-[-0.04em] text-ink">Build knowledge, not a random reading list.</h2></div>
      <p class="max-w-md text-sm leading-6 text-slate-600">Each hub connects foundational explainers, comparisons, reviews, and practical guides into a clear learning path.</p>
    </div>
    <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{clusters.map((cluster) => <TopicCard cluster={cluster} articleCount={articles.filter((article) => article.data.cluster.id === cluster.id).length} />)}</div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div><p class="text-xs font-black uppercase tracking-[0.18em] text-brand-dark">Latest from the lab</p><h2 class="mt-2 text-3xl font-black tracking-[-0.04em] text-ink">Useful reads, minus the gadget hype.</h2></div>
    <div class="no-scrollbar mt-7 flex gap-2 overflow-x-auto pb-2" aria-label="Filter articles by topic">{tabs.map(([key,label],index) => <button type="button" data-filter={key} aria-pressed={index===0?"true":"false"} class:list={["shrink-0 rounded-full border px-4 py-2 text-sm font-extrabold transition",index===0?"border-brand-dark bg-brand-dark text-white":"border-slate-200 bg-white text-slate-700 hover:border-emerald-300 hover:bg-emerald-50 hover:text-brand-dark"]}>{label}</button>)}</div>
    <div id="article-grid" class="mt-7 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{articles.map((article) => <ArticleCard article={article} />)}</div>
    <p id="empty-state" class="mt-8 hidden rounded-2xl border border-slate-200 bg-white p-8 text-center text-sm font-semibold text-slate-600">No articles in this filter yet.</p>
    <div class="mt-12"><Newsletter /></div>
  </section>
</SiteLayout>
<script is:inline>
(() => { const buttons=[...document.querySelectorAll("[data-filter]")]; const cards=[...document.querySelectorAll("[data-article-card]")]; const empty=document.getElementById("empty-state"); buttons.forEach((button)=>button.addEventListener("click",()=>{ const filter=button.dataset.filter||"all"; let visible=0; buttons.forEach((item)=>{const active=item===button; item.setAttribute("aria-pressed",String(active)); item.className=active?"shrink-0 rounded-full border border-brand-dark bg-brand-dark px-4 py-2 text-sm font-extrabold text-white transition":"shrink-0 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-extrabold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 hover:text-brand-dark";}); cards.forEach((card)=>{const show=filter==="all"||card.dataset.category===filter; card.classList.toggle("hidden",!show); if(show)visible++;}); empty?.classList.toggle("hidden",visible!==0); })); })();
</script>
