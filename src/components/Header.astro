---
import Logo from "./Logo.astro";

const nav = [
  ["Smart Energy", "/topics/smart-energy"],
  ["Home Automation", "/topics/home-automation"],
  ["Urban Living", "/topics/urban-living"],
  ["Reviews", "/topics/reviews"],
  ["About", "/about"]
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-[72px] max-w-7xl items-center gap-5 px-4 sm:px-6 lg:px-8">
    <Logo />

    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      {nav.map(([label, href]) => (
        <a
          href={href}
          class="rounded-lg px-3 py-2 text-sm font-bold text-slate-700 transition hover:bg-emerald-50 hover:text-brand-dark"
        >
          {label}
        </a>
      ))}
    </nav>

    <button
      id="search-open"
      type="button"
      class="ml-auto inline-flex size-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:border-emerald-300 hover:bg-emerald-50 hover:text-brand-dark lg:ml-2"
      aria-label="Open site search"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"/>
        <path d="m20 20-3.7-3.7"/>
      </svg>
    </button>

    <details class="group relative lg:hidden">
      <summary
        class="flex size-10 cursor-pointer list-none items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 shadow-sm hover:bg-slate-50"
        aria-label="Open navigation menu"
      >
        <svg viewBox="0 0 24 24" class="size-5 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
        <svg viewBox="0 0 24 24" class="hidden size-5 group-open:block" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m6 6 12 12M18 6 6 18"/>
        </svg>
      </summary>
      <nav
        class="absolute right-0 top-12 w-[min(88vw,320px)] overflow-hidden rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl"
        aria-label="Mobile navigation"
      >
        {nav.map(([label, href]) => (
          <a
            href={href}
            class="block rounded-xl px-4 py-3 text-sm font-bold text-slate-700 hover:bg-emerald-50 hover:text-brand-dark"
          >
            {label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<dialog
  id="search-dialog"
  class="m-auto w-[min(92vw,680px)] rounded-3xl border border-slate-200 bg-white p-0 shadow-2xl"
  aria-labelledby="search-title"
>
  <div class="p-5 sm:p-7">
    <div class="mb-5 flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-brand-dark">SmartAbodeLab</p>
        <h2 id="search-title" class="mt-1 text-xl font-extrabold tracking-tight text-ink">Search the lab</h2>
      </div>
      <button
        id="search-close"
        type="button"
        class="grid size-10 place-items-center rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200"
        aria-label="Close search"
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m6 6 12 12M18 6 6 18"/>
        </svg>
      </button>
    </div>
    <form action="/search" method="get" class="flex flex-col gap-3 sm:flex-row">
      <label class="sr-only" for="site-search">Search articles</label>
      <input
        id="site-search"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Try “Matter”, “smart thermostat”, “energy audit”…"
        class="min-w-0 flex-1 rounded-xl border border-slate-300 px-4 py-3.5 text-base text-ink shadow-inner placeholder:text-slate-400 focus:border-brand-dark focus:outline-none"
      />
      <button class="rounded-xl bg-brand-dark px-5 py-3.5 text-sm font-extrabold text-white transition hover:bg-emerald-800">
        Search
      </button>
    </form>
  </div>
</dialog>

<script is:inline>
  const dialog = document.getElementById("search-dialog");
  const open = document.getElementById("search-open");
  const close = document.getElementById("search-close");
  const field = document.getElementById("site-search");

  open?.addEventListener("click", () => {
    dialog?.showModal();
    requestAnimationFrame(() => field?.focus());
  });

  close?.addEventListener("click", () => dialog?.close());

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
