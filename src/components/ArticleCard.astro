---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../utils/content";

interface Props { article: CollectionEntry<"articles"> }
const { article } = Astro.props;
const categoryHref = article.data.categorySlug === article.data.cluster.id ? `/topics/${article.data.cluster.id}` : `/category/${article.data.categorySlug}`;
---
<article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-lg" data-article-card data-category={article.data.topic}>
  <a href={`/articles/${article.id}`} class="block overflow-hidden">
    <div class="aspect-video overflow-hidden bg-slate-100">
      <img src={article.data.image} alt={article.data.imageAlt} width="800" height="450" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.035]" />
    </div>
  </a>
  <div class="p-5">
    <div class="flex items-center gap-2 text-xs font-extrabold">
      <a href={categoryHref} class="rounded-full bg-emerald-50 px-2.5 py-1 text-brand-dark">{article.data.category}</a>
      <span class="text-slate-400">•</span><span class="text-slate-500">{article.data.readTime}</span>
    </div>
    <h3 class="mt-3 text-xl font-extrabold leading-tight tracking-[-0.025em] text-ink"><a href={`/articles/${article.id}`} class="transition hover:text-brand-dark">{article.data.title}</a></h3>
    <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600">{article.data.description}</p>
    <div class="mt-5 flex items-center justify-between gap-3">
      <time datetime={article.data.publishedAt.toISOString()} class="text-xs font-semibold text-slate-500">{formatDate(article.data.publishedAt)}</time>
      <a href={`/articles/${article.id}`} class="inline-flex items-center gap-1.5 text-sm font-extrabold text-brand-dark">Read article <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span></a>
    </div>
  </div>
</article>
