---
interface ReviewSummaryData {
  score: number;
  bestFor: string;
  verdict: string;
  pros: string[];
  cons: string[];
}
interface Props { review: ReviewSummaryData }
const { review } = Astro.props;
---
<section class="mt-8 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm" aria-labelledby="review-summary-title">
  <div class="grid gap-6 p-6 sm:grid-cols-[auto_1fr] sm:p-7">
    <div class="grid size-24 place-items-center rounded-2xl bg-brand-dark text-white">
      <div class="text-center"><strong class="block text-3xl font-black">{review.score.toFixed(1)}</strong><span class="text-xs font-bold text-emerald-100">out of 5</span></div>
    </div>
    <div>
      <p class="text-xs font-black uppercase tracking-[0.16em] text-brand-dark">Review verdict</p>
      <h2 id="review-summary-title" class="mt-1 text-2xl font-black tracking-tight text-ink">Best for: {review.bestFor}</h2>
      <p class="mt-3 text-sm leading-6 text-slate-600">{review.verdict}</p>
    </div>
  </div>
  <div class="grid border-t border-slate-200 sm:grid-cols-2">
    <div class="p-6">
      <p class="text-xs font-black uppercase tracking-[0.14em] text-emerald-800">Pros</p>
      <ul class="mt-3 grid gap-2 text-sm text-slate-700">{review.pros.map((item) => <li class="flex gap-2"><span class="font-black text-brand">✓</span><span>{item}</span></li>)}</ul>
    </div>
    <div class="border-t border-slate-200 p-6 sm:border-l sm:border-t-0">
      <p class="text-xs font-black uppercase tracking-[0.14em] text-amber-800">Cons</p>
      <ul class="mt-3 grid gap-2 text-sm text-slate-700">{review.cons.map((item) => <li class="flex gap-2"><span class="font-black text-warm">–</span><span>{item}</span></li>)}</ul>
    </div>
  </div>
</section>
