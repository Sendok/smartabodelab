---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../utils/content";

interface Props {
  sources: CollectionEntry<"articles">["data"]["sources"];
}

const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section class="not-prose mt-12 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="sources-title">
    <p class="text-xs font-black uppercase tracking-[0.16em] text-brand-dark">Evidence & further reading</p>
    <h2 id="sources-title" class="mt-2 text-2xl font-black tracking-tight text-ink">Sources & references</h2>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Primary and authoritative references used to support or contextualize this article. Links open the original source.</p>
    <ol class="mt-5 grid gap-4">
      {sources.map((source, index) => (
        <li class="grid grid-cols-[auto_1fr] gap-3 border-t border-slate-100 pt-4 first:border-0 first:pt-0">
          <span class="grid size-7 place-items-center rounded-full bg-emerald-50 text-xs font-black text-brand-dark">{index + 1}</span>
          <div>
            <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-sm font-extrabold text-ink hover:text-brand-dark hover:underline underline-offset-4">{source.title}</a>
            <p class="mt-1 text-xs font-semibold text-slate-500">{source.publisher}{source.accessedAt && ` · Accessed ${formatDate(source.accessedAt)}`}</p>
            {source.note && <p class="mt-1 text-sm leading-6 text-slate-600">{source.note}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>
)}
